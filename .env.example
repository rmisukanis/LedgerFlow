# Copy this file to .env and fill in the two QuickBooks keys once.
# .env stays on your laptop. It is listed in .gitignore.

# Intuit Developer Portal → your app → Keys & OAuth
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox

# Neon writes these into .env. DATABASE_URL is pooled and is what the app uses.
# DATABASE_URL_UNPOOLED is the direct connection, used only for schema changes.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# API server
PORT=5000
NODE_ENV=development

# Web app (separate port so it does not collide with the API)
WEB_PORT=5173
BASE_PATH=/
